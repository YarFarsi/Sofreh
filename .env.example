# Copy to .env for local development. Never commit .env.

# PostgreSQL
POSTGRES_USER=food
POSTGRES_PASSWORD=change-me-db-password
POSTGRES_DB=food_reservation
DATABASE_URL=postgresql://food:change-me-db-password@localhost:5432/food_reservation?schema=public

# Application
APP_URL=http://localhost:3000
NODE_ENV=development
TZ=Asia/Tehran

# Session signing / hashing (use a long random secret in production)
SESSION_SECRET=replace-with-a-long-random-secret-at-least-32-chars
SESSION_DAYS=7

# Local file storage
UPLOAD_DIR=/data/uploads

# Demo seed (development / demo only — disable in production)
SEED_DEMO=true
DEMO_ADMIN_EMAIL=admin@example.local
DEMO_ADMIN_PASSWORD=ChangeMe-Admin-0!
DEMO_USER_EMAIL=user@example.local
DEMO_USER_PASSWORD=ChangeMe-User-0!

# Optional internal SMTP. Leave empty; the app works without it.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_TLS=true
